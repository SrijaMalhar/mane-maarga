# Local development only. Never use these values in production.
APP_ENV=development
MANE_MAARGA_JWT_SECRET=replace-with-random-64-character-secret
MANE_MAARGA_JWT_TTL_MINUTES=60
MANE_MAARGA_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Tool endpoints (/api/tools) for machine callers. Leave empty to keep them closed.
MANE_MAARGA_SERVICE_TOKEN=
