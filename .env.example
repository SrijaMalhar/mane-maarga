# Local development only. Never use these values in production.
APP_ENV=development
MANE_MAARGA_JWT_SECRET=replace-with-random-64-character-secret
MANE_MAARGA_JWT_TTL_MINUTES=60
MANE_MAARGA_LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Tool endpoints (/api/tools) for machine callers. Leave empty to keep them closed.
MANE_MAARGA_SERVICE_TOKEN=

# Agent model: "mock" (scripted, no key needed) or "lyzr".
MANE_MAARGA_AGENT_PROVIDER=mock
MANE_MAARGA_LYZR_API_KEY=
MANE_MAARGA_LYZR_AGENT_ID=

# Bhashini (bhashini.gov.in, "My Profile" after sign-in) for Kannada/Telugu speech. Leave empty to disable.
MANE_MAARGA_BHASHINI_USER_ID=
MANE_MAARGA_BHASHINI_API_KEY=
# Optional; defaults to the MeitY pipeline.
MANE_MAARGA_BHASHINI_PIPELINE_ID=
